<Window x:Class="ProtocolLatencyAnalyzer.Desktop.MainWindow" x:Name="MainWindowRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProtocolLatencyAnalyzer.Desktop" Title="Protocol Latency Analyzer — By Limited Underground" Width="1440" Height="980" MinWidth="1040" MinHeight="700" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.CommandBindings>
  <CommandBinding Command="ApplicationCommands.New" Executed="NewCommand_Executed" CanExecute="FileCommand_CanExecute"/>
  <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCommand_Executed" CanExecute="FileCommand_CanExecute"/>
  <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" CanExecute="SaveCommand_CanExecute"/>
  <CommandBinding Command="{x:Static local:MainWindow.ExportCommand}" Executed="ExportCommand_Executed" CanExecute="FileCommand_CanExecute"/>
 </Window.CommandBindings>
 <DockPanel Background="#F4F7FB">
  <Menu DockPanel.Dock="Top" Background="#EAF0F6" Foreground="#17304D" Padding="8,2">
   <MenuItem Header="_File">
    <MenuItem Header="_New session" Command="ApplicationCommands.New" InputGestureText="Ctrl+N" CommandTarget="{Binding ElementName=MainWindowRoot}"/>
    <MenuItem Header="_Open session…" Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" CommandTarget="{Binding ElementName=MainWindowRoot}"/>
    <MenuItem Header="_Save session…" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" CommandTarget="{Binding ElementName=MainWindowRoot}"/>
    <MenuItem Header="_Export session metadata…" Command="{x:Static local:MainWindow.ExportCommand}" InputGestureText="Ctrl+E" CommandTarget="{Binding ElementName=MainWindowRoot}"/>
    <Separator/>
    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
   </MenuItem>
   <MenuItem Header="_Tools"><MenuItem Header="_Settings" Click="Settings_Click"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Background="#EAF0F6" BorderBrush="#CFDCE8" BorderThickness="0,0,0,1" Padding="16,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Protocol Latency Analyzer" FontWeight="Bold" FontSize="21"/><TextBlock Text="By Limited Underground  •  Portable Windows foundation" FontSize="12" Margin="0,3,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#EAF0F6" Padding="14,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}"/><TextBlock Grid.Column="1" Text="Phase 1 • No acquisition engine"/></Grid></Border>
  <Border DockPanel.Dock="Left" Width="188" Background="#EAF0F6" BorderBrush="#D4E0EA" BorderThickness="0,0,1,0">
   <DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom" Margin="8,15"><TextBlock Text="Foundation preview" FontWeight="SemiBold"/><TextBlock Text="Official brand assets pending" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged" BorderThickness="0" Background="Transparent" SelectedIndex="0" FontSize="14"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBoxItem Content="Dashboard"/><ListBoxItem Content="Active Tests"/><ListBoxItem Content="Custom Messages"/><ListBoxItem Content="Passive Capture"/><ListBoxItem Content="Protocol Explorer"/><ListBoxItem Content="Sessions"/><ListBoxItem Content="Reports"/><ListBoxItem Content="Settings"/><ListBoxItem Content="About"/></ListBox>
   </DockPanel>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
   <Border Background="#FFF3D6" BorderBrush="#E4BE65" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5" Visibility="{Binding DemoVisibility}"><TextBlock Text="DEMONSTRATION — synthetic preview only. No traffic is sent or captured. Preview readings are not saved as session measurements." FontWeight="SemiBold"/></Border>
   <Grid Margin="6,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="Bold"/><TextBlock Text="{Binding PageSubtitle}" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="Show demonstration preview" IsChecked="{Binding IsDemo}" VerticalAlignment="Center" Margin="10"/></Grid>
   <StackPanel x:Name="DashboardPanel">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ethernet interface" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="DisplayName" MinHeight="28"/><Button Grid.Column="2" Content="Refresh" Click="Refresh_Click"/></Grid><TextBlock Text="{Binding InterfaceGuidance}" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"/><Expander Header="Adapter details" IsExpanded="False" Margin="0,4,0,0"><TextBlock Text="{Binding InterfaceDetails}" Margin="0,5,0,0" FontSize="12"/></Expander><TextBlock Text="Link status only • destination route unverified" ToolTip="Connected means the link is up. Suggestions use local adapter metadata; traffic, Internet access and destination route are unverified. Selection records context only." FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Capture engine" FontWeight="SemiBold" Margin="0,0,15,0"/><TextBlock Text="Unavailable • not implemented"/></DockPanel><TextBlock Text="Native capture qualification is pending. No driver detection or capture has run." FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
    <UniformGrid Columns="6" x:Name="Metrics"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Transaction timing over time"/><TextBlock Text="{Binding ChartCaption}" FontSize="11"/><Viewbox Height="145" Stretch="Fill"><Canvas Width="620" Height="190" Background="#FBFCFE"><Path Stroke="#DCE5EE" Data="M 40,15 L 40,160 L 605,160 M 40,50 L 605,50 M 40,85 L 605,85 M 40,120 L 605,120 M 150,15 L 150,160 M 260,15 L 260,160 M 370,15 L 370,160 M 480,15 L 480,160"/><TextBlock Canvas.Left="5" Canvas.Top="5" Text="ms"/><TextBlock Canvas.Left="48" Canvas.Top="166" Text="Session timeline"/><Polyline x:Name="DemoLine" Stroke="#217BC1" StrokeThickness="2" Visibility="{Binding DemoVisibility}" Points="40,135 65,131 90,138 115,132 140,130 165,133 190,128 215,136 240,132 265,129 290,133 315,125 340,128 365,131 390,127 415,132 440,129 465,134 490,126 515,132 540,128 565,131 600,129"/><TextBlock Canvas.Left="175" Canvas.Top="75" Text="{Binding ChartEmpty}" FontSize="16"/></Canvas></Viewbox></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Protocol status"/><DataGrid ItemsSource="{Binding ProtocolRows}" Height="155"><DataGrid.Columns><DataGridTextColumn Header="Protocol" Binding="{Binding Name}" Width="110" MinWidth="100"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="170" MinWidth="160"/><DataGridTextColumn Header="Timing" Binding="{Binding Timing}" Width="110" MinWidth="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Recent events"/><DataGrid ItemsSource="{Binding Events}" Height="115"><DataGrid.Columns><DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="150" MinWidth="130"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="350" MinWidth="250"/></DataGrid.Columns></DataGrid></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Active tests"/><TextBlock Text="No tests running. Protocol execution is a later milestone."/><Button Content="View active-test milestone" Tag="Active Tests" Click="Go_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Packet capture • summary"/><TextBlock Text="Packets: unavailable&#10;Bytes: unavailable&#10;Capture drops: unavailable&#10;Capture state: not implemented" LineHeight="24"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Protocol discovery"/><TextBlock Text="No discovery has run. Adapter inventory is not traffic discovery."/><Button Content="View protocol explorer" Tag="Protocol Explorer" Click="Go_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Heading}" Text="Quick actions"/><Button Content="Active tests" Tag="Active Tests" Click="Go_Click"/><Button Content="Custom messages" Tag="Custom Messages" Click="Go_Click"/><Button Content="Passive capture" Tag="Passive Capture" Click="Go_Click"/><Button Content="Session details" Tag="Sessions" Click="Go_Click"/></StackPanel></Border>
    </Grid>
   </StackPanel>
   <Border x:Name="DetailPanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel x:Name="DetailContent"/></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
